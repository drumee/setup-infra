//
// Configs setup by Drumee setup-infra utility
//
<%
  // Mirror EXACTLY the conditions infra.js uses to decide which zone files it
  // writes (`data.public_ip4 && public_domain`, `data.private_ip4 &&
  // private_domain`). Declaring a zone whose file was never rendered makes
  // named reject its whole configuration, not just that zone, so the two sides
  // have to agree — they did not: the public reverse block was emitted from
  // reverse_public_ip4 alone, which survives own_certs_dir nulling the domain.
  var dns_pub_domain  = (typeof(public_domain)       !== "undefined" && public_domain)       ? public_domain       : "";
  var dns_priv_domain = (typeof(private_domain)      !== "undefined" && private_domain)      ? private_domain      : "";
  var dns_pub_ip      = (typeof(public_ip4)          !== "undefined" && public_ip4)          ? public_ip4          : "";
  var dns_priv_ip     = (typeof(private_ip4)         !== "undefined" && private_ip4)         ? private_ip4         : "";
  var dns_pub_rev     = (typeof(reverse_public_ip4)  !== "undefined" && reverse_public_ip4)  ? reverse_public_ip4  : "";
  var dns_priv_rev    = (typeof(reverse_private_ip4) !== "undefined" && reverse_private_ip4) ? reverse_private_ip4 : "";
  var dns_own_certs   = (typeof(own_certs_dir)       !== "undefined" && own_certs_dir)       ? own_certs_dir       : "";
  var dns_want_pub    = dns_pub_domain  && dns_pub_ip;
  // own_certs_dir nulls the private domain in infra.js — but it does so on a
  // LOCAL variable, so data.private_domain stays populated and this template
  // still sees it. Mirror the nulling here or the private zone gets declared
  // while its file is never written, and named refuses the whole configuration
  // over the missing file. Observed on a host that had been switched away from
  // tls_method=own: own_certs_dir persists in the rendered config, and only a
  // zone file left behind by an earlier render kept named loading at all.
  var dns_want_priv   = dns_priv_domain && dns_priv_ip && !dns_own_certs;
  // A single-NIC host — every LAN box, and the whole point of the self-signed
  // path — has private_ip4 == public_ip4, so both halves derive the SAME
  // reverse zone. Declaring "5.168.192.in-addr.arpa" twice is a hard error
  // ("zone already exists"), and named then serves nothing at all.
  var dns_dup_rev     = dns_want_pub && dns_want_priv && dns_pub_rev === dns_priv_rev;
%>
include "/etc/bind/named.conf.log";
include "<%= nsupdate_key %>";
<% if (dns_want_pub) { %>
zone "<%= dns_pub_domain %>" {
    type master;
    file "/var/lib/bind/<%= dns_pub_domain %>";
    allow-query { any; };
    allow-update { key "update"; };
    allow-transfer { <%= dns_pub_ip %>; };
};
<% } %>
<% if (dns_want_pub && dns_pub_rev) { %>
zone "<%= dns_pub_rev %>.in-addr.arpa" {
    type master;
    // infra.js renders public-reverse.tpl to /var/lib/bind/<public_ip4>, not to
    // <reverse_public_ip4>. Naming the reverse form here pointed the zone at a
    // file that is never written.
    file "/var/lib/bind/<%= dns_pub_ip %>";
    allow-query { any; };
};
<% } %>

<% if (dns_want_priv) { %>
zone "<%= dns_priv_domain %>" {
    type master;
    file "/var/lib/bind/<%= dns_priv_domain %>";
    allow-query { any; };
    allow-update { key "update"; };
    allow-transfer { <%= dns_priv_ip %>; };
};
<% } %>
<% if (dns_want_priv && dns_priv_rev && !dns_dup_rev) { %>
zone "<%= dns_priv_rev %>.in-addr.arpa" {
    type master;
    file "/var/lib/bind/<%= dns_priv_ip %>";
    allow-query { any; };
};
<% } %>
