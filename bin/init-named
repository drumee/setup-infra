#!/bin/bash
# Bring up the local authoritative DNS server for this instance.
#
# Called by bin/install when this instance is meant to serve its own zone —
# either to answer the ACME DNS-01 challenge by TSIG-signed dynamic update
# (tls_method=acme-dns-server), or to give a LAN-only instance a resolver for
# its own domain (tls_method=self-signed / local mode), where nothing else on
# the network knows the name at all.
#
# NOT set -e. This script used to die on its very first command: `service named
# stop` exits non-zero when the unit does not exist, which is the normal state
# on a host where bind9 was never installed — drumee-infra only Recommends it.
# The abort happened before the tsig key and the log directory were created, so
# the rendered zone referenced a key file that was never generated, and the
# whole failure was invisible because bin/install runs this under `set +e`.
set -u
source /etc/drumee/drumee.sh

echo "Configuring DNS server for $DRUMEE_DOMAIN_NAME"

# bind9 is a Recommends, not a Depends: three of the five TLS methods have no
# use for a nameserver, and installing one that squats udp/53 unasked is worse
# than not having it. So its absence is a normal, reportable outcome.
if ! command -v named >/dev/null 2>&1; then
  echo "  bind9 is not installed — no DNS server to configure." >&2
  echo "  The zone for $DRUMEE_DOMAIN_NAME has been rendered under /var/lib/bind and" >&2
  echo "  /etc/bind, so installing it is all that is left:" >&2
  # --force-confnew is load-bearing: bind9 ships /etc/bind/named.conf.local as a
  # conffile and the render above has already put ours there, so a plain install
  # stops at a conffile prompt and dpkg fails on a non-interactive stdin. The
  # reconfigure then renders ours back over the maintainer's.
  echo "      apt-get install -o Dpkg::Options::=--force-confnew bind9 bind9-utils" >&2
  echo "      dpkg-reconfigure drumee-infra" >&2
  exit 0
fi

service named stop >/dev/null 2>&1 || true

mkdir -p /var/log/named/
chown -R bind:bind /var/log/named/
mkdir -p /etc/bind/keys/

if [ "${NSUPDATE_KEY:-}" = "" ]; then
  export NSUPDATE_KEY=/etc/bind/keys/update.key
fi

# named.conf.local includes this file unconditionally, so a missing key is not
# merely a lost dynamic-update capability — named refuses to load its entire
# configuration over it, and the instance ends up with no DNS at all.
echo "Will use update key from $NSUPDATE_KEY"
if [ ! -f "$NSUPDATE_KEY" ]; then
  if ! command -v tsig-keygen >/dev/null 2>&1; then
    echo "  tsig-keygen not found (package bind9-utils) — cannot generate $NSUPDATE_KEY." >&2
    echo "  named would refuse to start on the missing include; not starting it." >&2
    echo "      apt-get install bind9-utils && dpkg-reconfigure drumee-infra" >&2
    exit 0
  fi
  echo "Generating tsig key"
  tsig-keygen -a hmac-sha512 update > "$NSUPDATE_KEY"
fi

chown -R bind:bind /etc/bind
chmod 0640 "$NSUPDATE_KEY"

# Check before restarting rather than after. named refuses its WHOLE
# configuration over one bad zone declaration, so a duplicate zone or a missing
# include costs the instance all of DNS, not just the zone at fault — and
# `service named start` reports that as a bare non-zero exit with the reason
# only in the journal. Say what is wrong here, while the operator is still
# watching the install scroll past.
#
# Plain named-checkconf, deliberately: it validates the configuration (includes,
# duplicate zones, syntax) without loading the zone files. `-z` additionally
# loads every zone, which turns any record-level complaint into "no DNS at all"
# — a strictly worse outcome than serving the zones that are fine. So -z runs
# too, but only to report.
if command -v named-checkconf >/dev/null 2>&1; then
  if ! checkconf_out=$(named-checkconf 2>&1); then
    echo "  named-checkconf rejected the rendered configuration:" >&2
    printf '    %s\n' "$checkconf_out" >&2
    echo "  Leaving named stopped — starting it would fail the same way." >&2
    exit 0
  fi
  if ! zone_out=$(named-checkconf -z 2>&1); then
    echo "  note: some zone files did not load cleanly (starting named anyway):" >&2
    printf '    %s\n' "$zone_out" >&2
  fi
fi


# ---------------------------------------------------------------------------
# Make THIS host resolve the zone it now serves.
#
# Serving a zone is not the same as using it. A LAN instance came up with named
# answering $DRUMEE_DOMAIN_NAME for the whole network while /etc/resolv.conf still
# pointed at the DHCP resolver, so the box could not resolve its own name: on-box
# `curl https://$DRUMEE_DOMAIN_NAME/` returned nothing while the identical request
# from any other machine on the LAN got the site. Everything on-box that refers to
# the instance by name resolved against a resolver that has never heard of the
# domain — drumee-ctl doctor's TLS probe, health checks, the password-reset URL in
# the welcome email if it is followed locally.
#
# Safe to do, for two reasons that are worth stating because both are load-bearing:
#
#  * the rendered named.conf.options sets `recursion yes` with public forwarders, so
#    127.0.0.1 is a complete resolver rather than an authoritative island. Pointing
#    the host at it does not cost it the rest of the internet.
#  * it goes in as the FIRST nameserver with the existing ones kept behind it. The
#    glibc resolver moves to the next server on refusal or timeout, so a named that
#    is down costs a retry, not all DNS. Never replace the list.
# ---------------------------------------------------------------------------
point_host_at_named() {
  local dom="$DRUMEE_DOMAIN_NAME" answered=""

  # Ask the server we are about to trust whether it actually knows the zone. Better
  # to leave the resolver alone than to point it at a named that loaded a broken
  # configuration — named-checkconf above passes on configurations whose zone files
  # do not load.
  if command -v dig >/dev/null 2>&1; then
    dig +short +time=2 +tries=1 SOA "$dom" @127.0.0.1 2>/dev/null | grep -q . && answered=1
  elif command -v host >/dev/null 2>&1; then
    host -W 2 -t SOA "$dom" 127.0.0.1 >/dev/null 2>&1 && answered=1
  else
    # No query tool at all (bind9-dnsutils and bind9-host both absent). named
    # started, so proceed rather than skipping the fix over a missing diagnostic.
    answered=1
  fi
  if [ -z "$answered" ]; then
    echo "  note: named does not answer SOA for $dom on 127.0.0.1 — leaving" >&2
    echo "  /etc/resolv.conf untouched. Check: journalctl -u named -n 50" >&2
    return 0
  fi

  # ---- persist it, per resolver manager ------------------------------------
  # Each manager regenerates resolv.conf on its own schedule, so writing the file
  # alone is a fix that survives until the next reboot. Configure the manager for
  # the persistent half, then edit the live file for the immediate half.
  if systemctl is-active --quiet systemd-resolved 2>/dev/null; then
    mkdir -p /etc/systemd/resolved.conf.d
    # Split DNS: only this domain is routed to the local named, everything else
    # keeps the path it already had. The narrowest change that fixes the problem.
    cat > /etc/systemd/resolved.conf.d/10-drumee.conf <<EOF
# Written by drumee-infra (bin/init-named). This host serves $dom itself.
[Resolve]
DNS=127.0.0.1
Domains=~$dom
EOF
    systemctl restart systemd-resolved >/dev/null 2>&1 \
      && echo "  systemd-resolved: $dom routed to the local named"
  elif systemctl is-active --quiet NetworkManager 2>/dev/null \
       && command -v nmcli >/dev/null 2>&1; then
    # ipv4.dns is an ORDERED list and NetworkManager writes resolv.conf in that
    # order, so 127.0.0.1 has to be its first element — not appended.
    #
    # This was `+ipv4.dns 127.0.0.1` in 1.2.28 and it did not survive a reboot,
    # which is worth recording because the failure was silent and looked fine until
    # then. `+` appends, so the profile ended up "8.8.8.8,127.0.0.1"; the live file
    # edited below still worked, so the install reported success. On the next boot NM
    # regenerated resolv.conf from the profile, in profile order, and the box asked
    # 8.8.8.8 for its own domain. glibc does NOT fall through to the next server on
    # NXDOMAIN — only on refusal or timeout — so an authoritative "no such name" from
    # a public resolver is final, and on-box resolution was broken again.
    #
    # Rewriting the whole list keeps the previous servers as fallback behind ours,
    # which is the same shape as the resolv.conf edit below.
    #
    # Deliberately NOT followed by `nmcli con up`: on the documented install path this
    # runs over ssh, and bouncing the connection carrying the install to apply a DNS
    # entry is a poor trade. The live file is edited below, so it applies now anyway.
    local c t cur rest
    while IFS=: read -r c t; do
      [ -n "$c" ] || continue
      # Loopback carries no useful DNS and 1.2.28 wrote to it anyway. Harmless, but
      # it is not ours to modify.
      [ "$t" = loopback ] && continue
      cur="$(nmcli -g ipv4.dns connection show "$c" 2>/dev/null)"
      rest="$(printf '%s' "$cur" | tr ',' '\n' | grep -vxF '127.0.0.1' | paste -sd, -)"
      if nmcli connection modify "$c" ipv4.dns "127.0.0.1${rest:+,$rest}" >/dev/null 2>&1; then
        echo "  NetworkManager: DNS on '$c' is now 127.0.0.1${rest:+,$rest}"
      fi
    done < <(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null)
  fi

  # ---- make it effective now ----------------------------------------------
  # Only a regular file. Under systemd-resolved or resolvconf this is a symlink into
  # /run, owned by that daemon; rewriting it would be undone and could leave a
  # dangling stub. The manager branch above has already handled those.
  if [ -L /etc/resolv.conf ]; then
    echo "  /etc/resolv.conf is managed by a daemon (symlink) — left as it is"
    return 0
  fi
  if [ "$(awk '/^nameserver/{print $2; exit}' /etc/resolv.conf 2>/dev/null)" = "127.0.0.1" ]; then
    return 0
  fi
  local tmp; tmp=$(mktemp)
  {
    echo "# 127.0.0.1 added by drumee-infra: this host is authoritative for $dom."
    echo "# The servers below are kept as fallback; glibc tries them if named is down."
    echo "nameserver 127.0.0.1"
    grep -v '^# 127.0.0.1 added by drumee-infra' /etc/resolv.conf 2>/dev/null \
      | grep -v '^# The servers below are kept as fallback'
  } > "$tmp"
  cat "$tmp" > /etc/resolv.conf && rm -f "$tmp"
  echo "  /etc/resolv.conf: 127.0.0.1 is now the first nameserver"
}

# Ask the question the operator would ask, through the SYSTEM resolver rather than by
# querying named directly. That distinction is the whole point: 1.2.28 configured the
# resolver in a way that worked when queried directly and failed through nsswitch after
# a reboot. A check that talks to 127.0.0.1 explicitly would have passed.
report_own_domain_resolution() {
  local dom="$DRUMEE_DOMAIN_NAME" got
  got="$(getent hosts "$dom" 2>/dev/null | awk '{print $1; exit}')"
  if [ -n "$got" ]; then
    echo "  this host resolves $dom -> $got"
  else
    echo "  warning: this host still cannot resolve $dom through its own resolver." >&2
    echo "  On-box checks against the domain (drumee-ctl doctor, health probes) will" >&2
    echo "  fail while everything works from the rest of the LAN. Current state:" >&2
    sed 's/^/    /' /etc/resolv.conf >&2
  fi
}

echo "Restarting named"
if service named start; then
  echo "DNS server has been successfully setup!"
  point_host_at_named
  report_own_domain_resolution
else
  echo "  named failed to start; see: journalctl -u named -n 50" >&2
fi
